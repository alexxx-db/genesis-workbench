# bionemo module registry credentials (BioNeMo custom-Docker cluster).
# Copy this file to `module.env` (gitignored) and fill in the values below.
#
# deploy.sh reads each line and passes it as a DAB --var, so these flow into
# var.bionemo_docker_{image,userid,token} in bionemo_finetune_esm.yml and
# bionemo_inference_esm.yml (docker_image.basic_auth).
#
# SECURITY (HARDENING_CHECKLIST.md §3): use Databricks secret-scope references,
# NEVER a plaintext PAT / NGC API key. Databricks Container Services resolves
# {{secrets/<scope>/<key>}} in basic_auth at cluster launch. Create the scope + keys
# once, before deploying bionemo:
#
#   databricks secrets create-scope gwb_bionemo
#   databricks secrets put-secret   gwb_bionemo bionemo_docker_userid
#   databricks secrets put-secret   gwb_bionemo bionemo_docker_token
#
# For NGC (nvcr.io) the username is the literal $oauthtoken and the password is your
# NGC API key — store the API key as the secret above. The image tag is not a secret;
# point it at the image you built and pushed (see modules/bionemo/docker/).

bionemo_docker_image=<your-registry>/bionemo:<tag>
bionemo_docker_userid={{secrets/gwb_bionemo/bionemo_docker_userid}}
bionemo_docker_token={{secrets/gwb_bionemo/bionemo_docker_token}}
