# genomics module registry credentials (Parabricks custom-Docker cluster).
# Copy this file to `module.env` (gitignored) and fill in the values below.
#
# deploy.sh reads each line and passes it as a DAB --var, so these flow into
# var.parabricks_docker_{image,userid,token} in parabricks_cluster.yml and the
# gwas parabricks_alignment.job.yml (docker_image.basic_auth).
#
# SECURITY (HARDENING_CHECKLIST.md §3): use Databricks secret-scope references,
# NEVER a plaintext PAT. Databricks Container Services resolves
# {{secrets/<scope>/<key>}} in basic_auth at cluster launch. Create the scope + keys
# once, before deploying genomics:
#
#   databricks secrets create-scope gwb_genomics
#   databricks secrets put-secret   gwb_genomics parabricks_docker_userid
#   databricks secrets put-secret   gwb_genomics parabricks_docker_token
#
# The image tag is not a secret — point it at the image you built and pushed
# (see modules/genomics/parabricks/parabricks_v1/docker/).

parabricks_docker_image=<your-registry>/parabricks:<tag>
parabricks_docker_userid={{secrets/gwb_genomics/parabricks_docker_userid}}
parabricks_docker_token={{secrets/gwb_genomics/parabricks_docker_token}}
