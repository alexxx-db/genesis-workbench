{
  "datasets": [
    {
      "name": "ffb6dc6d",
      "displayName": "Platform KPIs",
      "queryLines": [
        "SELECT\n",
        "  (SELECT count(*) FROM __CATALOG__.__SCHEMA__.models            WHERE is_active) AS registered_models,\n",
        "  (SELECT count(*) FROM __CATALOG__.__SCHEMA__.model_deployments WHERE is_active) AS live_endpoints,\n",
        "  (SELECT count(*) FROM __CATALOG__.__SCHEMA__.node_catalog      WHERE is_active) AS workflow_nodes,\n",
        "  (SELECT count(*) FROM __CATALOG__.__SCHEMA__.sequence_db)                       AS reference_sequences,\n",
        "  (SELECT count(*) FROM __CATALOG__.__SCHEMA__.gene_sequences)                    AS human_proteins,\n",
        "  (SELECT count(*) FROM __CATALOG__.__SCHEMA__.repurposing_hub)                   AS drugs\n"
      ]
    },
    {
      "name": "3315323e",
      "displayName": "Models by module",
      "queryLines": [
        "SELECT\n",
        "  model_category AS module,\n",
        "  count(*)                                              AS registered,\n",
        "  sum(CASE WHEN is_model_deployed THEN 1 ELSE 0 END)    AS deployed\n",
        "FROM __CATALOG__.__SCHEMA__.models\n",
        "WHERE is_active\n",
        "GROUP BY model_category\n",
        "ORDER BY registered DESC\n"
      ]
    },
    {
      "name": "81b69a20",
      "displayName": "Drugs by clinical phase",
      "queryLines": [
        "SELECT\n",
        "  coalesce(nullif(trim(clinical_phase), ''), 'Unspecified') AS clinical_phase,\n",
        "  count(*)                                                  AS drugs\n",
        "FROM __CATALOG__.__SCHEMA__.repurposing_hub\n",
        "GROUP BY 1\n",
        "ORDER BY drugs DESC\n"
      ]
    },
    {
      "name": "46f22f2a",
      "displayName": "Model catalog",
      "queryLines": [
        "SELECT\n",
        "  m.model_display_name  AS model,\n",
        "  m.model_category      AS module,\n",
        "  m.model_source_version AS version,\n",
        "  m.model_uc_name       AS unity_catalog_model,\n",
        "  m.is_model_deployed   AS deployed,\n",
        "  m.model_added_by      AS added_by,\n",
        "  m.model_added_date    AS added\n",
        "FROM __CATALOG__.__SCHEMA__.models m\n",
        "WHERE m.is_active\n",
        "ORDER BY m.model_category, m.model_display_name\n"
      ]
    },
    {
      "name": "233b07dc",
      "displayName": "Live serving endpoints",
      "queryLines": [
        "SELECT\n",
        "  d.model_endpoint_name AS endpoint,\n",
        "  m.model_display_name  AS model,\n",
        "  m.model_category      AS module,\n",
        "  d.model_deployed_by   AS deployed_by,\n",
        "  d.model_deployed_date AS deployed\n",
        "FROM __CATALOG__.__SCHEMA__.model_deployments d\n",
        "LEFT JOIN __CATALOG__.__SCHEMA__.models m ON m.model_id = d.model_id\n",
        "WHERE d.is_active\n",
        "ORDER BY d.model_deployed_date DESC\n"
      ]
    }
  ],
