{
  "datasets": [
    {
      "name": "46c5d4c9",
      "displayName": "Inference KPIs",
      "queryLines": [
        "SELECT\n",
        "  count(*)                                                          AS requests,\n",
        "  count(DISTINCT endpoint)                                          AS endpoints_used,\n",
        "  round(100.0 * sum(CASE WHEN status_code >= 400 THEN 1 ELSE 0 END)\n",
        "        / nullif(count(*), 0), 2)                                   AS error_rate_pct,\n",
        "  round(percentile_approx(execution_duration_ms, 0.50))             AS p50_latency_ms,\n",
        "  round(percentile_approx(execution_duration_ms, 0.95))             AS p95_latency_ms\n",
        "FROM alexxx.genesis_workbench.v_inference_log\n"
      ]
    },
    {
      "name": "9c29b089",
      "displayName": "Requests by endpoint",
      "queryLines": [
        "SELECT\n",
        "  endpoint,\n",
        "  count(*)                                              AS requests,\n",
        "  round(percentile_approx(execution_duration_ms, 0.95)) AS p95_latency_ms\n",
        "FROM alexxx.genesis_workbench.v_inference_log\n",
        "GROUP BY endpoint\n",
        "ORDER BY requests DESC\n"
      ]
    },
    {
      "name": "55c835b5",
      "displayName": "Requests over time",
      "queryLines": [
        "SELECT\n",
        "  date_trunc('HOUR', request_time) AS hour,\n",
        "  endpoint,\n",
        "  count(*)                         AS requests\n",
        "FROM alexxx.genesis_workbench.v_inference_log\n",
        "GROUP BY 1, 2\n",
        "ORDER BY 1\n"
      ]
    },
    {
      "name": "73608483",
      "displayName": "Recent requests",
      "queryLines": [
        "SELECT\n",
        "  request_time,\n",
        "  endpoint,\n",
        "  status_code,\n",
        "  execution_duration_ms,\n",
        "  client_request_id,\n",
        "  substr(request, 1, 160)  AS request_preview,\n",
        "  substr(response, 1, 160) AS response_preview\n",
        "FROM alexxx.genesis_workbench.v_inference_log\n",
        "ORDER BY request_time DESC\n",
        "LIMIT 200\n"
      ]
    }
  ],
